# Copiar a .env para sobreescribir defaults (todos opcionales)
LLM_PROVIDER=mock             # mock | openai
OPENAI_API_KEY=
LLM_DEFAULT_TIMEOUT_S=30      # si el request no manda config.timeout_s
LLM_MAX_TIMEOUT_S=120
ALLOWED_MODELS=gpt-4o,gpt-4o-mini
API_KEYS=dev-key-123:client-demo,dev-key-456:client-b
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_FAIL_OPEN=true     # si Redis no responde: true = dejar pasar
CACHE_TTL_S=3600
SINGLE_FLIGHT_LOCK_TTL_S=35   # > LLM_DEFAULT_TIMEOUT_S
SINGLE_FLIGHT_WAIT_S=30
CB_FAILURE_THRESHOLD=5
CB_FAILURE_WINDOW_S=30
CB_OPEN_DURATION_S=60
STREAM_STALL_TIMEOUT_S=10     # slow consumer: aborta si un chunk no se drena en N s
